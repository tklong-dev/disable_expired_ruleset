# Cloudflare API Token
# Tao token tai: https://dash.cloudflare.com/profile/api-tokens
# Quyen can thiet: Zone > Firewall Services > Read & Edit
CF_API_TOKEN=your_cloudflare_api_token_here

# Telegram Bot
# Tao bot qua @BotFather, them bot vao group va lay CHAT_ID
TG_BOT_TOKEN=your_telegram_bot_token_here
TG_CHAT_ID=your_telegram_group_chat_id_here

# Thoi gian cho phan hoi tu Telegram (giay), mac dinh 120
TG_TIMEOUT=120